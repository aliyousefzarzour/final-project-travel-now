# =================== TRAVELNOW .env ===================
# Copy this to .env and fill in your values

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/travelnow

# JWT
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Admin Bootstrap Credentials (to log in as admin)
ADMIN_EMAIL=admin@travelnow.com
ADMIN_PASSWORD=change_this_to_a_unique_random_password
# Email (Nodemailer — Gmail with App Password recommended)
# Create App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=TravelNow <yourgmail@gmail.com>

# Paymob Hosted Checkout (sandbox only; obtain Test-mode credentials from Accept Dashboard)
PAYMOB_MODE=sandbox
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CALLBACK_URL=
PAYMOB_RETURN_URL=
